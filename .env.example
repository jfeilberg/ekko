# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=

# Composio — optional; without it Composio integration is disabled (bot still works via MCP + custom + built-in tools).
COMPOSIO_API_KEY=

# Optional opt-out filter. Empty/unset = all toolkits the user has connected via Composio.
# Set to a comma-separated list to restrict the agent to specific toolkits (e.g., for governance).
# Example: COMPOSIO_ENABLED_TOOLKITS=gmail,linear
COMPOSIO_ENABLED_TOOLKITS=

# Postgres connection string. Provisioned automatically when you add Neon via
# Vercel Marketplace. Also works with Supabase, Railway, or local Postgres.
DATABASE_URL=

# Vercel AI Gateway — auto-injected on Vercel when AI Gateway is enabled on your team
AI_GATEWAY_API_KEY=
# Optional model overrides
LLM_MODEL=anthropic/claude-opus-4.8
EMBEDDING_MODEL=openai/text-embedding-3-small

# Cron — auto-injected by Vercel when cron jobs are configured; leave empty if not using
CRON_SECRET=

# Optional
SYSTEM_PROMPT_OVERRIDE=
ALLOW_CROSS_CHANNEL_POST=false
# Max tool-use loop steps before forcing a final answer
MAX_AGENT_STEPS=16

# MCP servers — configure in lib/tools/custom/mcp-servers.ts.
# Tokens read from process.env at runtime should be added to this file as needed, e.g.:
# GATLAS_TOKEN=

# Idempotency state — leave empty to use in-memory dedup (single-instance only).
# Set to a Redis URL for cross-instance idempotency in production deployments.
REDIS_URL=

# Optional access control. open = everyone can use Ekko (default).
# allowlist = only users / channels listed in EKKO_ALLOWED_USERS / EKKO_ALLOWED_CHANNELS.
EKKO_ACCESS_MODE=open
EKKO_ALLOWED_USERS=
EKKO_ALLOWED_CHANNELS=
